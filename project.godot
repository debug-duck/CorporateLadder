; Engine configuration file.
config_version=5

[application]

config/name="Corporate Ladder"
config/description="Vertical arcade climber: climb the corporate skyscraper, dodge what the departments throw at you, demand a raise."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
run/max_fps=60
boot_splash/bg_color=Color(0.56, 0.77, 0.94, 1)
boot_splash/image="res://assets/sprites/logo.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/icon="res://icon.png"

[autoload]

Save="*res://game/core/save.gd"
Sfx="*res://game/core/sfx.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/LuckiestGuy-Regular.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.56, 0.77, 0.94, 1)
